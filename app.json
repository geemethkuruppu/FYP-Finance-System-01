{
  "expo": {
    "name": "finxai-app",
    "slug": "finxai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "finxaiapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
